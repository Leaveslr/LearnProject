{
  "slug": "ch01_cross_entropy",
  "title": "损失函数与交叉熵",
  "segments": [
    {
      "duration": 6.5,
      "subtitle": "模型训练时，必须有一个扣分规则。损失函数就是告诉模型：你这次猜得有多离谱。",
      "visual": {"type": "title", "headline": "模型怎么知道自己错了？", "subhead": "Loss = 训练里的扣分规则"}
    },
    {
      "duration": 8.0,
      "subtitle": "比如上下文是“我今天很”，真实答案是“开心”。模型给“开心”的概率越高，扣分越少。",
      "visual": {"type": "bars", "items": [{"label": "开心", "value": 60, "text": "0.60"}, {"label": "难过", "value": 20, "text": "0.20"}, {"label": "北京", "value": 1, "text": "0.01"}]}
    },
    {
      "duration": 8.0,
      "subtitle": "最大似然的直觉是：让训练数据里真实出现的 token，在模型眼里越来越可信。",
      "visual": {"type": "pipeline", "steps": ["真实序列", "预测每一步", "提高正确概率", "降低 loss"], "caption": "模型越相信真实答案，训练越满意"}
    },
    {
      "duration": 8.0,
      "subtitle": "对单个样本，交叉熵可以先记成：Loss 等于负的 log 正确 token 概率。",
      "visual": {"type": "formula", "formula": "Loss = -log P(正确 token)", "items": [{"title": "0.9", "body": "惩罚小"}, {"title": "0.5", "body": "惩罚中等"}, {"title": "0.01", "body": "惩罚很大"}]}
    },
    {
      "duration": 8.0,
      "subtitle": "为什么取 log？因为多个 token 的概率相乘会变得很小，取 log 后可以变成相加，更稳定。",
      "visual": {"type": "compare", "items": [{"title": "概率相乘", "body": "数值容易很小"}, {"title": "log 相加", "body": "训练更稳定"}]}
    },
    {
      "duration": 8.0,
      "subtitle": "语言模型每一步其实是在超大词表里做分类：lm_head 输出 logits，softmax 变成 token 概率。",
      "visual": {"type": "pipeline", "steps": ["hidden state", "lm_head", "logits", "softmax", "概率"], "caption": "next token prediction = 多分类"}
    },
    {
      "duration": 8.0,
      "subtitle": "Perplexity 是交叉熵的指数形式，可以理解为模型对下一个 token 的平均困惑程度。",
      "visual": {"type": "compare", "items": [{"title": "PPL 低", "body": "更不困惑"}, {"title": "PPL 高", "body": "更拿不准"}]}
    },
    {
      "duration": 8.0,
      "subtitle": "但 loss 或 PPL 低，不等于对话质量一定好。指令遵循、事实性和工具调用还要单独评估。",
      "visual": {"type": "trace", "items": [{"label": "Loss", "text": "拟合训练分布"}, {"label": "PPL", "text": "语言建模困惑度"}, {"label": "真实效果", "text": "还要看任务成功率"}]}
    },
    {
      "duration": 8.0,
      "subtitle": "做指令微调时，常见做法是只让 assistant 的回答承担 loss，用户问题更多是条件，不是要模型模仿的答案。",
      "visual": {"type": "trace", "items": [{"label": "user", "text": "提供上下文条件"}, {"label": "assistant", "text": "主要计算训练 loss"}, {"label": "mask", "text": "决定哪些 token 被扣分"}]}
    },
    {
      "duration": 8.0,
      "subtitle": "记住三句话：loss 是扣分规则；交叉熵惩罚不相信正确 token；评估 LLM 不能只看 loss。",
      "visual": {"type": "summary", "points": ["Loss 是扣分规则", "交叉熵看正确 token 概率", "PPL 不能代表一切"]}
    }
  ]
}
