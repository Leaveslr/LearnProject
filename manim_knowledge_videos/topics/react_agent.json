{
  "slug": "react_agent",
  "title": "ReAct Agent 机制",
  "segments": [
    {
      "duration": 6.0,
      "subtitle": "普通大模型像是在回答问题，Agent 更像是在做任务。ReAct 就是让它边想边行动。",
      "visual": {"type": "title", "headline": "Agent 怎么做任务？", "subhead": "ReAct = Reason + Act"}
    },
    {
      "duration": 8.0,
      "subtitle": "只调用一次 LLM，通常只能得到一段回答；但真实任务经常需要搜索、计算、检查和修正。",
      "visual": {"type": "compare", "items": [{"title": "单次回答", "body": "直接给结论"}, {"title": "任务执行", "body": "需要多步工具和反馈"}]}
    },
    {
      "duration": 8.5,
      "subtitle": "ReAct 把流程拆成三步：Thought 是思考，Action 是调用工具，Observation 是看到工具结果。",
      "visual": {"type": "loop", "steps": ["Thought", "Action", "Observation", "Next Thought"], "center": "循环推进任务"}
    },
    {
      "duration": 8.5,
      "subtitle": "一条典型轨迹是：先想缺什么，再调用搜索或计算，观察结果后再决定是否继续。",
      "visual": {"type": "trace", "items": [{"label": "Thought", "text": "我缺少最新价格"}, {"label": "Action", "text": "search_web(...)"}, {"label": "Observation", "text": "拿到结果，再判断下一步"}]}
    },
    {
      "duration": 8.0,
      "subtitle": "比如用户问一个需要最新信息和计算的问题，Agent 会先判断：我缺什么信息？该用哪个工具？",
      "visual": {"type": "pipeline", "steps": ["任务", "缺信息", "选工具", "执行"], "caption": "先判断缺口，再选择动作"}
    },
    {
      "duration": 8.0,
      "subtitle": "工具返回结果后，它不会立刻结束，而是把 Observation 放回上下文，继续思考下一步。",
      "visual": {"type": "pipeline", "steps": ["工具结果", "观察", "更新判断", "下一步"], "caption": "Observation 会改变后续决策"}
    },
    {
      "duration": 8.5,
      "subtitle": "所以 ReAct 的强项不是更会聊天，而是能把复杂任务变成可检查的行动轨迹。",
      "visual": {"type": "compare", "items": [{"title": "Reason", "body": "解释为什么要做"}, {"title": "Act", "body": "真的调用工具"}, {"title": "Trace", "body": "留下可检查过程"}]}
    },
    {
      "duration": 8.0,
      "subtitle": "它也有风险：想错工具、观察误读、循环太久，都会让 Agent 跑偏。",
      "visual": {"type": "bars", "items": [{"label": "选错工具", "value": 3, "text": "方向错"}, {"label": "误读结果", "value": 4, "text": "判断错"}, {"label": "循环过长", "value": 2, "text": "成本高"}]}
    },
    {
      "duration": 8.0,
      "subtitle": "工程上通常会加工具白名单、最大步数、结构化输出和状态检查，让循环可控。",
      "visual": {"type": "pipeline", "steps": ["工具白名单", "最大步数", "状态检查", "最终回答"], "caption": "可控比“看起来聪明”更重要"}
    },
    {
      "duration": 7.5,
      "subtitle": "什么时候停？当观察结果已经足够回答，或者达到最大步数，就应该收束成最终答案。",
      "visual": {"type": "compare", "items": [{"title": "可以回答", "body": "收束成 Final Answer"}, {"title": "步数用完", "body": "停止并说明限制"}]}
    },
    {
      "duration": 8.0,
      "subtitle": "记住三句话：Thought 决定下一步，Action 改变环境，Observation 让 Agent 校准判断。",
      "visual": {"type": "summary", "points": ["Thought 决定下一步", "Action 改变环境", "Observation 校准判断"]}
    }
  ]
}
